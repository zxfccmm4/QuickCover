    "3.2.6" : {
      "comment" : "copy.md §3.2 第一次读截图 · 3.2.6 · 正文下面的小字。系统弹窗里有「只给一部分照片」这个选项，先说清楚选了会怎样",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只给一部分照片的话，秒遮只看得到你选的那几张，新截的图要自己选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只給一部分照片的話，秒遮只看得到你選的那幾張，新的螢幕快照要自己選。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you give access to only some photos, QuickCover sees just those, so you'll need to choose each new screenshot yourself."
          }
        }
      }
    },
