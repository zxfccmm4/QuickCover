    "about.legal.footer": {
      "comment": "Legal section footer",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos stay strictly on your iPhone. All detection, Apple Intelligence scanning, and masking run locally—even in Airplane Mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的所有图片严格留在本地手机上。视觉识别、Apple Intelligence 语义扫描与打码渲染全部在端侧完成，飞行模式也能正常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的所有圖片嚴格留在本地手機上。視覺識別、Apple Intelligence 語意掃描與打碼算圖全部在端側完成，飛航模式也能正常使用。"
          }
        }
      }
    },
