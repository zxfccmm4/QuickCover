    "whatsnew.v1_0_5.longshot.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stitch multiple screenshots or screen recordings seamlessly on-device with automatic overlap detection and fine seam adjustment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持多图纵向/横向拼接与录屏自动拼长图，端侧智能去重并可逐像素微调接缝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援多圖縱向／橫向拼接與螢幕錄影自動拼長圖，端側智慧去重並可逐像素微調接縫。"
          }
        }
