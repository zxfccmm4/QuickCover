    "about.license.sdkBody": {
      "comment": "Notice SDK body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Photos' generative Clean Up pixel model is currently not exposed as a public third-party API in iOS 26/27. QuickCover's Magic Erase uses pure on-device four-edge inverse-distance interpolation with anti-bleed filtering—never reading interior pixels—so masked text leaves zero trace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26/27 尚未向第三方开放系统「照片」Clean Up 生成式像素补图模型。秒遮的「魔术消除」采用端侧四向边界逆距离插值与防渗色中值滤波，绝不读取遮挡区内部像素，确保无字迹残留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26/27 尚未向第三方開放系統「照片」Clean Up 生成式像素補圖模型。秒遮的「魔術消除」採用端側四向邊界逆距離插值與防滲色中值濾波，絕不讀取遮擋區內部像素，確保無字跡殘留。"
          }
        }
      }
    },
