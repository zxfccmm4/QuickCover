    "about.cap.ai.title": {
      "comment": "Capability title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
