    "about.cap.magic.detail": {
      "comment": "Capability detail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstructs masked areas strictly from exterior boundary samples using inverse-distance interpolation and sliding-median anti-bleed filtering—leaving zero residual text trace while blending smoothly across gradients, cards, and chat bubbles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格仅从遮挡区外缘四向采样，结合滑动中值去渗色与逆距离插值重建背景，不读取内部任何像素，既保证零字迹残留，又能在渐变卡片、聊天气泡与文档背景上平滑过渡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴格僅從遮擋區外緣四向取樣，結合滑動中值去滲色與逆距離插值重建背景，不讀取內部任何像素，既保證零字跡殘留，又能在漸層卡片、聊天氣泡與文件背景上平滑過渡。"
          }
        }
      }
    },
    "about.cap.magic.h1": {
      "comment": "Capability highlight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero interior pixel reads ensure complete redaction"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不读取遮挡区内部像素，彻底杜绝字迹残留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不讀取遮擋區內部像素，徹底杜絕字跡殘留"
          }
        }
      }
    },
    "about.cap.magic.h2": {
      "comment": "Capability highlight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60fps iridescent shimmer & particle effects honoring Reduce Motion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60fps 虹彩扫光与粒子动画，完整遵循「减弱动态效果」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
