    "about.cap.tools.detail": {
      "comment": "Capability detail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay customizable diagonal anti-theft watermarks with live preview of text, opacity, and density. Import images from Screenshots, Photos, Files, Clipboard, or the native VisionKit document scanner for ID cards and receipts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可叠加自定义斜向防盗水印，实时预览文字、透明度与密度；支持最近截图快速导入、相册、文件、剪贴板粘贴，以及原生 VisionKit 文档扫描仪拍摄证件和票据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可疊加自訂斜向防盜浮水印，即時預覽文字、透明度與密度；支援最近截圖快速匯入、相簿、檔案、剪貼簿貼上，以及原生 VisionKit 文件掃描器拍攝證件與票據。"
          }
        }
      }
    },
    "about.cap.tools.h1": {
      "comment": "Capability highlight",
