    "about.license.depsBody": {
      "comment": "Notice deps body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickCover is built exclusively with Apple system frameworks (SwiftUI, Vision, FoundationModels, VisionKit, PhotosUI, CoreGraphics) and contains zero third-party runtime dependencies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮完全基于 Apple 原生系统框架（SwiftUI、Vision、FoundationModels、VisionKit、PhotosUI、CoreGraphics）构建，不包含任何第三方运行时依赖。"
          }
        },
        "zh-Hant": {
