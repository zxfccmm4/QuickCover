    "about.cap.vision.detail": {
      "comment": "Capability detail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powered by Apple Vision across Simplified Chinese, Traditional Chinese, and English to automatically locate faces, phone numbers, ID cards, bank cards, emails, URLs, IP addresses, QR codes, and barcodes the moment a screenshot opens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用系统原生 Vision 框架，支持简体中文、繁体中文与英文混合识别，打开截图即可自动框出人脸、手机号、身份证号、银行卡号、邮箱、网址、IP 地址、二维码与条形码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採用系統原生 Vision 框架，支援簡體中文、繁體中文與英文混合識別，開啟截圖即可自動框出人臉、手機號碼、身分證字號、銀行卡號、Email、網址、IP 位址、QR Code 與條碼。"
          }
        }
      }
    },
