    "about.cap.privacy.detail": {
      "comment": "Capability detail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickCover has no accounts, no analytics, and no network calls. Exporting generates a fresh PNG or JPEG copy with GPS coordinates and camera metadata stripped by default, leaving your original photo untouched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮不设账号、不连服务器、不收集任何统计与崩溃数据。导出时生成全新 PNG 或 JPEG 图片，默认剥离 GPS 拍摄地点与设备型号等元数据，绝不改动相册原图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮不設帳號、不連伺服器、不收集任何統計與當機資料。匯出時產生全新 PNG 或 JPEG 圖片，預設剝離 GPS 拍攝地點與裝置型號等中繼資料，絕不改動相簿原圖。"
          }
        }
      }
    },
    "about.cap.privacy.h1": {
      "comment": "Capability highlight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works completely offline—even in Airplane Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全离线运行，开启飞行模式也可正常识别与导出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完全離線運作，開啟飛航模式也能正常識別與匯出"
          }
        }
      }
    },
    "about.cap.privacy.h2": {
      "comment": "Capability highlight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-destructive export preserves your original photo"
