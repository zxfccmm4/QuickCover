            "value": "60fps 虹彩掃光與粒子動畫，完整遵循「減少動態效果」"
          }
        }
      }
    },
    "about.cap.magic.sub": {
      "comment": "Capability subtitle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seamless boundary interpolation & starlight particle dissolves"
          }
        },
