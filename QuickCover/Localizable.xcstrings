    "about.cap.ai.detail": {
      "comment": "Capability detail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses iOS 26+ FoundationModels directly on-device to catch contextual private text lines that deterministic regex rules miss—such as personal names, street addresses, workplaces, order codes, license plates, and balances."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 iOS 26+ 端侧 FoundationModels 模型，对截图中的 OCR 文本做本地语义判别，自动补全常规规则容易遗漏的姓名、收货地址、单位/学校、订单号、车牌与金额等隐私信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於 iOS 26+ 端側 FoundationModels 模型，對截圖中的 OCR 文字進行本地語意判別，自動補齊常規規則容易遺漏的姓名、收貨地址、單位/學校、訂單號、車牌與金額等隱私資訊。"
          }
        }
      }
    },
    "about.cap.ai.h1": {
      "comment": "Capability highlight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% on-device inference with zero cloud uploads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 端侧离线推理，文本与图片永不上传云端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 端側離線推論，文字與圖片永不上傳雲端"
          }
        }
      }
    },
    "about.cap.ai.h2": {
      "comment": "Capability highlight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic local contextual fallback when Apple Intelligence is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开启 Apple Intelligence 时自动回退至本机上下文引擎"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未開啟 Apple Intelligence 時自動回退至本機上下文引擎"
          }
        }
      }
    },
    "about.cap.ai.sub": {
      "comment": "Capability subtitle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device semantic detection for names, addresses & orders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端侧语义识别姓名、住址、公司与订单号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端側語意識別姓名、地址、公司與訂單號"
          }
        }
      }
    },
    "about.cap.ai.title": {
      "comment": "Capability title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 语义识别"
          }
        },
        "zh-Hant": {
          "stringUnit": {
