    "about.overview.primary": {
      "comment": "About overview paragraph 1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickCover is a native iOS privacy redaction app built with Liquid Glass—combining Vision detection, on-device Apple Intelligence semantic scanning, six mask styles with custom colors and the full 1,900+ Emoji library, Magic Erase, tiled watermarks, and metadata-free export."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮是一款基于 iOS 原生 Liquid Glass 打造的端侧隐私打码应用，结合 Vision 视觉识别、Apple Intelligence 端侧语义扫描、6 种可配色遮挡样式与 1900+ 全套表情库、魔术消除、防盗水印及无痕隐私导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮是一款基於 iOS 原生 Liquid Glass 打造的端側隱私打碼應用，結合 Vision 視覺識別、Apple Intelligence 端側語意掃描、6 種可配色遮擋樣式與 1900+ 全套表情庫、魔術消除、防盜浮水印及無痕隱私匯出。"
          }
        }
      }
    },
    "about.overview.secondary": {
      "comment": "About overview paragraph 2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built with pure Swift 6 and SwiftUI with zero third-party dependencies. Your photos stay strictly on your iPhone, even in Airplane Mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用纯 Swift 6 与 SwiftUI 构建，零第三方依赖。识别与渲染全程在手机本地完成，飞行模式也能放心使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採用純 Swift 6 與 SwiftUI 建構，零第三方依賴。識別與算圖全程在手機本地完成，飛航模式也能放心使用。"
          }
        }
      }
    },
    "about.privacy.p1": {
      "comment": "Privacy commitment 1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All image inspection, face/text/barcode recognition, and mask rendering happen 100% on your device. QuickCover never uploads your screenshots or photos to any server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有图片读取、人脸/文字/二维码识别与遮挡渲染 100% 在本机完成，秒遮绝不将任何截图或照片上传至外部服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有圖片讀取、人臉/文字/條碼識別與遮擋算圖 100% 在本機完成，秒遮絕不將任何截圖或照片上傳至外部伺服器。"
          }
        }
      }
    },
    "about.privacy.p2": {
      "comment": "Privacy commitment 2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Apple Intelligence semantic scanning is triggered, text analysis runs strictly through Apple's on-device FoundationModels or the local contextual engine—with zero cloud network requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发 Apple Intelligence 语义扫描时，文本分析严格通过本机端侧 FoundationModels 或本地规则引擎完成，全程零网络请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸發 Apple Intelligence 語意掃描時，文字分析嚴格透過本機端側 FoundationModels 或本地規則引擎完成，全程零網路請求。"
          }
        }
      }
    },
    "about.privacy.p3": {
      "comment": "Privacy commitment 3",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickCover only reads the image you choose to redact and writes a brand-new image on export. Your original photo in Photos is never modified or overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮仅读取你选择处理的图片，并在导出时生成一张全新图片，绝不修改或覆盖相册中的原始照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮僅讀取你選擇處理的圖片，並在匯出時產生一張全新圖片，絕不修改或覆寫相簿中的原始照片。"
          }
        }
      }
    },
    "about.privacy.p4": {
      "comment": "Privacy commitment 4",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location and camera metadata stripping is enabled by default on export so shared screenshots and photos do not leak GPS coordinates or device details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出时默认开启「去掉位置信息」，自动清除 GPS 拍摄地点与设备元数据，防止分享图片时意外泄露定位隐私。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出時預設開啟「移除位置資訊」，自動清除 GPS 拍攝地點與裝置中繼資料，防止分享圖片時意外洩露定位隱私。"
          }
        }
      }
    },
    "about.privacy.p5": {
      "comment": "Privacy commitment 5",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickCover collects zero analytics, zero crash tracking, zero advertising identifiers, and requires no account or sign-in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮不收集任何行为统计、崩溃追踪或广告标识符，无需注册登录，真正开箱即用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秒遮不收集任何行為統計、當機追蹤或廣告識別碼，無需註冊登入，真正開箱即用。"
          }
        }
      }
    },
