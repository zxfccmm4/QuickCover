    "about.cap.styles.detail": {
      "comment": "Capability detail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch effortlessly between Mosaic, 45° Stripes, Magic Erase, Solid, Blur, and Emoji with Liquid Glass matched-geometry controls. Customize mosaic, stripe, and solid colors with 12 presets or the native iOS ColorPicker, or search and pick from the entire 1,900+ Unicode Emoji library across all 9 categories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在马赛克、45° 斜条、魔术消除、纯色、模糊与表情贴纸间无缝切换。支持给马赛克、斜条与纯色自定义 12 款精选色或原生全色谱颜色，并内置完整 Unicode 16.0 共 1900+ 表情库，支持全部 9 大分类浏览与中英文实时搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在馬賽克、45° 斜條、魔術消除、純色、模糊與表情貼紙間無縫切換。支援為馬賽克、斜條與純色自訂 12 款精選色或原生全色譜顏色，並內建完整 Unicode 16.0 共 1900+ 表情庫，支援全部 9 大分類瀏覽與中英文即時搜尋。"
          }
        }
      }
    },
