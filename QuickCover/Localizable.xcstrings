    "3.2.1" : {
      "comment" : "copy.md §3.2 第一次读截图 · 3.2.1 · 标题",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让秒遮找到你的截图"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓秒遮找到你的螢幕快照"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let QuickCover Find Your Screenshots"
          }
        }
      }
    },
    "3.2.2" : {
      "comment" : "copy.md §3.2 第一次读截图 · 3.2.2 · 正文。系统弹窗问的是照片，所以这里先说照片",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秒遮要访问你的照片，才能找到最近的截图。允许后，一打开就是最近一张，已经遮好。图片不离开手机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秒遮需要取用你的照片，才能找到最近的螢幕快照。允許後，一打開就是最近一張，已經遮好。圖片不離開手機。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickCover needs access to your photos to find your latest screenshot. Once allowed, it opens on that screenshot already covered. Images never leave your phone."
          }
        }
      }
    },
    "3.2.3" : {
      "comment" : "copy.md §3.2 第一次读截图 · 3.2.3 · 主按钮，点了出系统弹窗。系统弹窗里的确切用字等 Pluso 的实拍",
      "extractionState" : "manual",
      "localizations" : {
